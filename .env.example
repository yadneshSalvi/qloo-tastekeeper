DATABASE_URL=postgresql://qloo:qloo_local_dev@127.0.0.1:55432/tastekeeper
APP_ORIGIN=http://127.0.0.1:3104
CONTEXT_ENCRYPTION_KEY=generate-with-pnpm-demo-setup
CLIENT_BOOKS_SECRET=generate-with-pnpm-demo-setup
CLIENT_MEDIA_SECRET=generate-with-pnpm-demo-setup
CLIENT_PLACES_SECRET=generate-with-pnpm-demo-setup
DEMO_ENABLED=true
# Live capabilities may be enabled on web without provider credentials.
QLOO_ENABLED=false
AGENT_ENABLED=false
QLOO_MAPPINGS_FILE=
# Worker only. Use an operator-verified model identifier.
QLOO_API_KEY=
QLOO_TRANSPORT=insights
OPENAI_API_KEY=
MODEL_ID=
QLOO_GLOBAL_DAILY_LIMIT=120
QLOO_TENANT_DAILY_LIMIT=8
QLOO_SEARCH_TENANT_DAILY_LIMIT=6
OPENAI_GLOBAL_DAILY_LIMIT=240
OPENAI_TENANT_DAILY_LIMIT=16
# Production: separate migration job and verified database TLS.
DATABASE_MIGRATION_URL=
DATABASE_CA_FILE=
# Default verify-full. Cloud SQL private IP may explicitly pin its unique instance CA.
DATABASE_TLS_IDENTITY=verify-full
# Cloud Tasks dispatch (web only); worker requires IAM at the service boundary.
GOOGLE_CLOUD_PROJECT=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=
WORKER_ORIGIN=
WORKER_INVOKER_SERVICE_ACCOUNT=
WORKER_AUTH_MODE=
