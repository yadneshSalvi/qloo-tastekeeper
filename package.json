{
  "name": "tastekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3104",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3104",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "demo:setup": "node scripts/setup.mjs",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "qloo:probe": "tsx scripts/qloo-probe.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "worker:http": "tsx scripts/worker-http.ts",
    "client:books": "tsx --env-file=.env.books.local clients/server.ts",
    "client:media": "tsx --env-file=.env.media.local clients/server.ts",
    "client:places": "tsx --env-file=.env.places.local clients/server.ts",
    "test": "tsx --test tests/*.node.test.ts",
    "test:db": "tsx --env-file=.env.local --test --test-concurrency=1 tests/*.integration.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@qloo/qloo-harness": "0.1.26",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "lucide-react": "0.577.0",
    "next": "16.4.3",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
